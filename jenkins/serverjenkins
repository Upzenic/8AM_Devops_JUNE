pipeline {
    agent any

    stages {
        stage('Find Master Server Details') {
            steps {
                bat '''
                @echo off

                echo ================================
                echo Jenkins Master Server Details
                echo ================================

                echo.
                echo Computer Name:
                hostname

                echo.
                echo Current User:
                whoami

                echo.
                echo Current Date and Time:
                date /t
                time /t

                echo.
                echo Operating System:
                systeminfo | findstr /B /C:"OS Name" /C:"OS Version"

                echo.
                echo IP Address:
                ipconfig | findstr "IPv4"

                echo.
                echo Memory Details:
                systeminfo | findstr /C:"Total Physical Memory" /C:"Available Physical Memory"

                echo.
                echo Disk Details:
                wmic logicaldisk get caption,freespace,size

                echo.
                echo Jenkins Home:
                echo %JENKINS_HOME%

                echo.
                echo Java Version:
                java -version

                echo.
                echo Git Version:
                git --version
                '''
            }
        }
    }
}
