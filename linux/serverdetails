pipeline {
    agent any

    stages {
        stage('Get Windows Server Details') {
            steps {
                bat '''
                echo ===== Server Name =====
                hostname

                echo.
                echo ===== OS Details =====
                systeminfo | findstr /B /C:"OS Name" /C:"OS Version"

                echo.
                echo ===== IP Address =====
                ipconfig

                echo.
                echo ===== CPU Details =====
                wmic cpu get name

                echo.
                echo ===== Memory Details =====
                wmic computersystem get TotalPhysicalMemory

                echo.
                echo ===== Disk Details =====
                wmic logicaldisk get caption,size,freespace
                '''
            }
        }
    }
}
